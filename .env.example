# Razorpay (optional — online payment stays "Coming Soon" in checkout until these are set)
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must mirror RAZORPAY_KEY_ID exactly — this one is exposed to the browser (NEXT_PUBLIC_*),
# the secret above never is.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Sign-In (optional — /account stays open/local-only and /login shows
# "Coming Soon" until both of these are set)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to add there: <your-site-url>/api/auth/callback/google
# (for local dev: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must mirror GOOGLE_CLIENT_ID exactly — this one is exposed to the browser (NEXT_PUBLIC_*),
# the secret above never is. A Google OAuth Client ID is not secret by itself.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Required by NextAuth once Google Sign-In is enabled above. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
# Base URL NextAuth uses for callbacks. Update to your production domain on deploy.
NEXTAUTH_URL=http://localhost:3000
